{"_note": "Alert rules seed (§15) — mirrors ALERT_RULES in src/lib/alerts.js. Editable at /admin/alerts.", "rules": [{"code": "ALR-ASSIGNED", "when": "Event", "to": "Assignee", "channel": "In-app, email", "repeat": "Once"}, {"code": "ALR-TASK-DUE", "when": "Daily 07:00", "days": 3, "to": "Owner", "channel": "In-app, email", "repeat": "Once"}, {"code": "ALR-DEADLINE", "when": "Daily 07:00", "to": "Owner, unit head", "channel": "In-app, email, SMS", "repeat": "Weekly"}, {"code": "ALR-BEHIND", "when": "Nightly engine", "to": "Owner, unit head", "channel": "In-app, email", "repeat": "7 days"}, {"code": "ALR-DELAY-REASON", "when": "Daily", "days": 3, "to": "Parent unit head", "channel": "In-app, email", "repeat": "7 days"}, {"code": "ALR-NO-UPDATE", "when": "Daily", "days": 3, "to": "Owner → supervisor", "channel": "In-app, email", "repeat": "3 days"}, {"code": "ALR-REVIEW-WAIT", "when": "Daily", "days": 3, "to": "Reviewer", "channel": "In-app", "repeat": "3 days"}, {"code": "ALR-TIPPANI-WAIT", "when": "Daily", "days": 5, "to": "Step holder, then supervisor", "channel": "In-app, email, SMS", "repeat": "3 days"}, {"code": "ALR-PROC-STAGE", "when": "Daily", "to": "Procurement owner, unit head", "channel": "In-app, email", "repeat": "7 days"}, {"code": "ALR-MILESTONE", "when": "Daily", "to": "Work owner, finance", "channel": "In-app, email", "repeat": "7 days"}, {"code": "ALR-SECURITY", "when": "Daily", "to": "Work owner, finance", "channel": "In-app, email, SMS", "repeat": "At 30 and 7 days"}, {"code": "ALR-SPEND-MISMATCH", "when": "Nightly engine", "to": "Unit head, finance", "channel": "In-app, email", "repeat": "14 days"}, {"code": "ALR-LOW-UTIL", "when": "Weekly (Sun)", "pct": 50, "to": "Unit head, ministry finance", "channel": "In-app, email", "repeat": "Weekly"}, {"code": "ALR-DIRECTIVE", "when": "Event + daily", "days": 2, "to": "Recipient; issuer on overdue", "channel": "In-app, email", "repeat": "Daily when overdue"}, {"code": "ALR-APPROVAL-ACTION", "when": "Event", "to": "Submitter", "channel": "In-app, email", "repeat": "Once"}, {"code": "ALR-SECURITY-LOGIN", "when": "Event", "to": "User, SUPER_ADMIN on lock", "channel": "Email", "repeat": "Once"}]}
